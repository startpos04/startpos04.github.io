{
  "name": "startPOS",
  "private": true,
  "scripts": {
    "env:generate": "tsx scripts/generate-env.ts",

    "dev": "turbo dev",
    "dev:web": "pnpm --filter @startpos/web dev",
    "dev:website": "pnpm --filter @startpos/website dev",
    "dev:admin": "pnpm --filter @startpos/admin dev",
    "dev:calling-card": "pnpm --filter @startpos/calling-card dev",

    "build": "turbo build",
    "build:web": "pnpm --filter @startpos/web build",
    "build:website": "pnpm --filter @startpos/website build",
    "build:admin": "pnpm --filter @startpos/admin build",

    "lint": "biome lint --write",
    "check": "biome check --write",
    "format": "biome format --write",
    
    "start": "turbo start",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "type-check": "turbo type-check",
    "generate": "turbo generate",
    "validate": "turbo validate",
    "coverage": "turbo coverage",
    "coverage:integration": "turbo coverage:integration",

    "db:generate": "pnpm --filter @startpos/platform prisma:generate",
    "db:push": "tsx --env-file=apps/web/.env --env-file=.env.config --tsconfig=packages/platform/tsconfig.json packages/platform/prisma/db-push.ts",
    "db:seed": "tsx --env-file=apps/web/.env --env-file=.env.config --tsconfig=packages/platform/tsconfig.json packages/platform/prisma/seeders/index.ts",
    "db:reset": "tsx --env-file=apps/web/.env --env-file=.env.config --tsconfig=packages/platform/tsconfig.json packages/platform/prisma/reset-db.ts",
    "db:studio": "tsx --env-file=apps/web/.env --env-file=.env.config scripts/db-studio.ts",

    "docker:web": "docker compose --env-file apps/web/.env up --build --watch web db db-init",
    "docker:admin": "docker compose --env-file apps/admin/.env up --build --watch admin db db-init",
    "docker:calling-card": "docker compose up --build --watch calling-card",
    "docker:website": "docker compose up --build --watch website",
    "docker:all": "docker compose --env-file apps/web/.env up --build --watch",
    "docker:down": "docker compose --env-file apps/web/.env down",
    "docker:exec:web": "docker compose --env-file apps/web/.env exec -it web",
    "docker:exec:admin": "docker compose --env-file apps/admin/.env exec -it admin",

    "stripe:setup": "docker compose --env-file apps/web/.env --profile stripe up --build stripe-setup",
    "stripe:webhook": "docker compose --env-file apps/web/.env --profile stripe up --build stripe-webhook",
    "stripe:start": "docker compose --env-file apps/web/.env --profile stripe up --build stripe-setup stripe-webhook",
    "stripe:down": "docker compose --env-file apps/web/.env --profile stripe stop stripe-setup stripe-webhook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "cspell": "^10.0.0",
    "lefthook": "^2.1.6",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.0.0"
}
