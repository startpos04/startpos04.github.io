// =============================================================================
// ADMIN MODELS — Platform admin panel accounts
//
// Completely separate from the tenant User/Session/Account tables.
// Admin users cannot log into the tenant app and tenant users cannot log
// into the admin panel. The Better Auth instance in apps/admin is configured
// to use these tables via modelMapping.
// =============================================================================

enum AdminRole {
  SUPERADMIN // Full platform access
  SUPPORT // Read-only access to tenant data, can manage tickets
  FINANCE // Access to billing, invoices, subscription management
  DEVELOPER // Technical access, can view logs and system config
  TESTER // QA access — can run the QA Companion, record results, and file defects
}

model AdminUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          AdminRole @default(SUPPORT)

  sessions AdminSession[]
  accounts AdminAccount[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  adminUserPermissions AdminUserPermission[]

  @@index([deletedAt])
  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_sessions")
}

model AdminAccount {
  id         String  @id @default(cuid())
  accountId  String
  providerId String
  password   String?

  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_accounts")
}

model AdminVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("admin_verifications")
}

// =============================================================================
// ADMIN PERMISSION TABLES
//
// Mirrors the tenant UserPermission / RoleDefaultPermission pattern but
// scoped to AdminUser rather than the tenant User table.
// The Permission table is shared — permissions with scope=ADMIN are the
// ones that appear here.
// =============================================================================

// AdminUserPermission — custom per-user grants/revokes for admin users
model AdminUserPermission {
  id           String    @id @default(cuid())
  userId       String // AdminUser.id
  permissionId String // Permission.id (scope = ADMIN)
  granted      Boolean   @default(true) // true = granted, false = explicitly revoked
  grantedBy    String? // AdminUser.id of granting superadmin
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime?
  note         String?

  user       AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId, granted])
  @@index([permissionId])
  @@map("admin_user_permissions")
}

// AdminRoleDefaultPermission — which permissions each AdminRole gets by default
model AdminRoleDefaultPermission {
  id           String    @id @default(cuid())
  role         AdminRole
  permissionId String // Permission.id (scope = ADMIN)
  createdAt    DateTime  @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("admin_role_default_permissions")
}
